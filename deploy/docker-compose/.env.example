POSTGRES_DB=retailops
POSTGRES_USER=retailops
POSTGRES_PASSWORD=retailops_local_password
DATABASE_URL=postgresql+asyncpg://retailops:retailops_local_password@postgres:5432/retailops
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-local-development-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
DOCUMENT_STORAGE_DIR=/var/lib/retailops/documents
PAYMENT_PROVIDER=local
NOTIFICATION_PROVIDER=local_smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@retailops.local
AUTH_SERVICE_URL=http://auth-service:8000
CATALOG_SERVICE_URL=http://catalog-service:8000
ORDER_SERVICE_URL=http://order-service:8000
DOCUMENT_SERVICE_URL=http://document-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
WORKFLOW_SERVICE_URL=http://workflow-service:8000
UPSTREAM_TIMEOUT_SECONDS=5
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
WORKFLOW_WORKER_ENABLED=true
WORKFLOW_WORKER_CONSUMER_NAME=workflow-service-local
