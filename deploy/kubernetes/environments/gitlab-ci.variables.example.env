# Kubernetes access
KUBE_CONFIG_B64=<base64-encoded-kubeconfig>

# Optional cluster identity metadata
PROJECT_DISPLAY_NAME=RetailOps-microservices-platform
K8S_CLUSTER_NAME=retailops-k8s-prod
K8S_API_SERVER=https://10.20.0.10:6443
K8S_DEPLOY_SERVICE_ACCOUNT=gitlab-deployer

# Existing cluster services
INGRESS_CLASS=nginx
INGRESS_LOAD_BALANCER_IP=10.20.30.10
STORAGE_CLASS_NAME=standard-rwo
TEST_INGRESS_HOST=test.retailops.internal
PROD_INGRESS_HOST=retailops.internal

# Application secrets
MWP_POSTGRES_PASSWORD=change-me-postgres-password
MWP_JWT_SECRET_KEY=change-me-jwt-secret-key

# Optional long-lived pull credentials. Set both or neither.
K8S_REGISTRY_USER=registry-deploy-token
K8S_REGISTRY_PASSWORD=change-me-registry-token
